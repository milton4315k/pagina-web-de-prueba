# Copiá este archivo a .env y completá los valores. NO subas .env a git.

NODE_ENV=development
PORT=3000

# Conexión para la app en runtime (Supavisor, modo transaction).
# statement_mode=direct es obligatorio: el pooler no soporta prepared statements.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?statement_mode=direct

# Conexión directa, solo para migraciones.
DATABASE_MIGRATION_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173

# Dueño del panel. Formato internacional sin + ni espacios: 5491128493108
ADMIN_WHATSAPP=5491128493108

# Base pública del sitio, se usa para armar el link wa.me del login.
PUBLIC_SITE_URL=http://localhost:4173

# Para firmar la cookie de sesión (mínimo 32 caracteres).
SESSION_SECRET=cambiar-esto-por-una-cadena-aleatoria-larga