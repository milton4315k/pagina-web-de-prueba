{
  "name": "nocturna-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/dist/bin/node-pg-migrate.js -m migrations -d $DATABASE_MIGRATION_URL up",
    "migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/dist/bin/node-pg-migrate.js -m migrations -d $DATABASE_MIGRATION_URL down",
    "migrate:status": "node --env-file-if-exists=.env node_modules/node-pg-migrate/dist/bin/node-pg-migrate.js -m migrations -d $DATABASE_MIGRATION_URL status",
    "migrate:make": "node --env-file-if-exists=.env node_modules/node-pg-migrate/dist/bin/node-pg-migrate.js -m migrations create",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "overrides": {
    "glob": "^11.0.4"
  },
  "devDependencies": {
    "dotenv": "^18.0.5",
    "node-pg-migrate": "^7.9.1",
    "pg-mem": "^3.0.14"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
