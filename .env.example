# ============================================================
# Nocturna Pizza — variables de entorno
# ------------------------------------------------------------
# Copiá este archivo a ".env" (en la raíz) y completá los valores.
# El .env NO se sube al repo: en Render se cargan a mano en
# "Environment". Este archivo (.env.example) sí se sube.
# ============================================================

# --- General ------------------------------------------------
NODE_ENV=development
PORT=3000

# URL pública del sitio. En Render completala con la URL del
# servicio, por ejemplo: https://nocturna-pizza.onrender.com
PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del local, en formato internacional, solo dígitos.
ADMIN_WHATSAPP=5491128493108

# Emails con acceso al panel, separados por coma.
ADMIN_EMAILS=miltonrobertocarlos12k@gmail.com

# --- Supabase: base de datos --------------------------------
# Supabase -> Connect -> (Connection string) -> URI.
# DATABASE_URL: pooler en modo "Transaction" (puerto 6543), para la app.
# DATABASE_MIGRATION_URL: pooler "Session" (puerto 5432), para migrar.
# Ojo: la contraseña va tal cual, sin las llaves <>.
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres
DATABASE_MIGRATION_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# --- Supabase: Auth (login con Google) ----------------------
# Supabase -> Project Settings -> API Keys.
# La anon key es pública; la service_role es SECRETA y no se usa
# en el navegador.
SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- OpenAI (asistente virtual) -----------------------------
OPENAI_API_KEY=sk-TU_API_KEY
OPENAI_MODEL=gpt-4o-mini

# --- Solo desarrollo local (opcional) -----------------------
# Si no definís DATABASE_URL, el server intenta esta base local.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nocturna
