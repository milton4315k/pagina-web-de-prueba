# ============================================================
# Nocturna Pizza — variables de entorno
# ------------------------------------------------------------
# Copiá este archivo a ".env" (en la raíz) y completá los valores.
# El .env NO se sube al repo: en Render se cargan a mano en
# "Environment". Este archivo (.env.example) sí se sube.
# ============================================================

# --- General ------------------------------------------------
NODE_ENV=development
PORT=3000

# URL pública del sitio. En Render completala con la URL del
# servicio, por ejemplo: https://nocturna-pizza.onrender.com
PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del local, en formato internacional, solo dígitos.
ADMIN_WHATSAPP=5491128493108

# Emails con acceso al panel, separados por coma.
ADMIN_EMAILS=miltonrobertocarlos12k@gmail.com

# --- Base de datos (OPCIONAL) -------------------------------
# Si dejás DATABASE_URL vacío, la app arranca en "modo estático":
# solo el sitio. Pedidos, contacto, Pase y panel quedan
# deshabilitados.
#
# Para tener todas las funciones, completá las dos URLs
# (Supabase, Neon, Railway o cualquier Postgres).
# DATABASE_URL: conexión para la app.
# DATABASE_MIGRATION_URL: conexión para migrar (puede ser la misma).
DATABASE_URL=
DATABASE_MIGRATION_URL=

# --- Supabase Auth (OPCIONAL: login con Google) -------------
# Solo hace falta si usás el Pase Nocturno o el panel.
# Supabase -> Project Settings -> API Keys.
# La anon key es pública; la service_role es SECRETA.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Asistente virtual (OPCIONAL) ---------------------------
# El chatbot funciona sin base de datos y sin OpenAI: usa la
# información de docs/menu.md y docs/negocio.md.
#
# Con OPENAI_API_KEY responde con IA y RAG. Después de cargarla,
# corré: npm run rag:index
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
